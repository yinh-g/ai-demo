{
  "expo": {
    "name": "FitTrack",
    "slug": "fittrack",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6366F1"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.fittrack"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6366F1",
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.yourcompany.fittrack",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": "允许 $(PRODUCT_NAME) 使用 Face ID 登录"
        }
      ]
    ],
    "extra": {
      "supabase": {
        "url": "https://pnncwyozewabagebdgxv.supabase.co",
        "anonKey": "sb_publishable_4fu8BY9uwrqS7xLzlUwEBQ_5A76zEEw"
      }
    }
  }
}
